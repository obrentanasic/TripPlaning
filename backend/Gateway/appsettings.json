{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "putopis",
    "Audience": "putopis-clients",
    "Secret": "putopis-dev-secret-do-not-use-in-prod-please-use-env-var-32chars-min",
    "LifetimeHours": 24
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "users",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "users",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "trips": {
        "ClusterId": "trips",
        "Match": { "Path": "/api/trips/{**catch-all}" }
      },
      "admin-trips": {
        "ClusterId": "trips",
        "Match": { "Path": "/api/admin/trips/{**catch-all}" }
      },
      "share": {
        "ClusterId": "share",
        "Match": { "Path": "/api/share/{**catch-all}" }
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "users-1": { "Address": "http://localhost:8081/" }
        }
      },
      "trips": {
        "Destinations": {
          "trips-1": { "Address": "http://localhost:8082/" }
        }
      },
      "share": {
        "Destinations": {
          "share-1": { "Address": "http://localhost:8083/" }
        }
      }
    }
  }
}
