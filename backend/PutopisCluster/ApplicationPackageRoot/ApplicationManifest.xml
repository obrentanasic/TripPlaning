<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest
    ApplicationTypeName="PutopisType"
    ApplicationTypeVersion="1.0.0"
    xmlns="http://schemas.microsoft.com/2011/01/fabric"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <Parameters>
    <Parameter Name="Gateway_InstanceCount" DefaultValue="-1" />
    <Parameter Name="Users_InstanceCount" DefaultValue="-1" />
    <Parameter Name="Trips_InstanceCount" DefaultValue="-1" />
    <Parameter Name="Share_PartitionCount" DefaultValue="1" />
    <Parameter Name="Share_TargetReplicaSetSize" DefaultValue="3" />
    <Parameter Name="Share_MinReplicaSetSize" DefaultValue="2" />
  </Parameters>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="GatewayPkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="UsersPkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="TripsPkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="SharePkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>

  <DefaultServices>
    <Service Name="Gateway" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="Putopis.GatewayType" InstanceCount="[Gateway_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>

    <Service Name="Users" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="Putopis.UsersType" InstanceCount="[Users_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>

    <Service Name="Trips" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="Putopis.TripsType" InstanceCount="[Trips_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>

    <Service Name="Share" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService
          ServiceTypeName="Putopis.ShareType"
          TargetReplicaSetSize="[Share_TargetReplicaSetSize]"
          MinReplicaSetSize="[Share_MinReplicaSetSize]">
        <UniformInt64Partition PartitionCount="[Share_PartitionCount]" LowKey="0" HighKey="1" />
      </StatefulService>
    </Service>
  </DefaultServices>
</ApplicationManifest>
